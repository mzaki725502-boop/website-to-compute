<!doctype html>

<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Smile Search</title>
  <meta name="description" content="Smile Search — simple single-file search page with a black & white smiling emoji logo." />
  <style>
    :root{
      --bg:#fff;
      --fg:#000;
      --muted:#666;
      --glass: rgba(0,0,0,0.04);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
    }
    html,body{height:100%;}
    body{
      margin:0;
      background:var(--bg);
      color:var(--fg);
      -webkit-font-smoothing:antialiased;
      display:flex;
      align-items:center;
      justify-content:center;
    }
    .wrap{
      width:min(860px,94vw);
      text-align:center;
      padding:48px 24px;
    }
    /* Logo */
    .logo{
      display:inline-grid;
      grid-template-rows: auto auto;
      gap:16px;
      align-items:center;
      justify-items:center;
    }
    .smile-svg{
      width:132px;
      height:132px;
      display:block;
      filter: drop-shadow(0 6px 18px rgba(0,0,0,0.12));
      transition:transform .28s ease;
    }
    .smile-svg:hover{transform:translateY(-6px) scale(1.03)}
    .brand{
      font-weight:700;
      letter-spacing:0.6px;
      font-size:20px;
      color:var(--fg);
      display:flex;
      gap:10px;
      align-items:center;
    }
    .brand .dot{
      width:10px;height:10px;border-radius:50%;background:var(--fg);
    }
    /* Search box */
    .search-box{
      margin-top:28px;
      display:flex;
      align-items:center;
      justify-content:center;
      gap:12px;
    }
    .search-input{
      width:min(680px,72vw);
      max-width:100%;
      padding:14px 18px;
      border-radius:28px;
      border:1px solid var(--glass);
      box-shadow:inset 0 1px 0 rgba(255,255,255,0.6);
      outline:none;
      font-size:16px;
    }
    .search-input:focus{border-color:rgba(0,0,0,0.15);box-shadow:0 6px 30px rgba(0,0,0,0.06)}
    .search-btn{
      border-radius:22px;
      padding:10px 16px;
      border:1px solid var(--fg);
      background:var(--fg);
      color:var(--bg);
      font-weight:600;
      cursor:pointer;
      font-size:15px;
    }
    .search-btn:active{transform:translateY(1px)}
    .hint{
      margin-top:16px;color:var(--muted);font-size:13px;
    }
    /* Results (simulated) */
    .results{
      margin-top:28px;
      display:grid;
      gap:12px;
    }
    .card{
      text-align:left;
      padding:14px 16px;border-radius:10px;border:1px solid var(--glass);
      background:linear-gradient(180deg, rgba(255,255,255,0.6), rgba(255,255,255,0.9));
    }
    .card .title{font-weight:700;color:var(--fg)}
    .card .desc{color:var(--muted);font-size:14px;margin-top:6px}
    footer{margin-top:38px;color:var(--muted);font-size:13px}
    @media (max-width:520px){
      .smile-svg{width:92px;height:92px}
      .brand{font-size:18px}
      .search-input{padding:12px}
    }
  </style>
</head>
<body>
  <main class="wrap" role="main">
    <div class="logo" aria-hidden="false">
      <!-- Black & white smiling emoji built with SVG -->
      <svg class="smile-svg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Smile Search logo">
        <rect width="100%" height="100%" fill="none" />
        <!-- Circle face -->
        <circle cx="100" cy="100" r="86" fill="#ffffff" stroke="#000000" stroke-width="8" />
        <!-- Left eye -->
        <circle cx="70" cy="80" r="10" fill="#000000" />
        <!-- Right eye -->
        <circle cx="130" cy="80" r="10" fill="#000000" />
        <!-- Smile (path) -->
        <path d="M60 120 Q100 155 140 120" stroke="#000000" stroke-width="8" fill="none" stroke-linecap="round" stroke-linejoin="round" />
      </svg><div class="brand" aria-hidden="true">
    <span style="font-size:18px">Smile Search</span>
    <span class="dot" title="Logo indicator"></span>
  </div>
</div>

<form id="searchForm" class="search-box" role="search" aria-label="Search form">
  <input id="q" class="search-input" type="search" autocomplete="off" placeholder="Ketik untuk mencari..." aria-label="Kata kunci pencarian" />
  <button id="btn" class="search-btn" type="submit" aria-label="Cari">Cari</button>
</form>

<div class="hint">Tekan <kbd>/</kbd> untuk fokus, <strong>Enter</strong> untuk cari. Hasil langsung membuka Google.</div>

<div id="results" class="results" aria-live="polite"></div>

<footer>
  Simple single-file demo — desain hitam putih. Tidak menyimpan data lokal.
</footer>

  </main>  <script>
    (function(){
      const form = document.getElementById('searchForm');
      const input = document.getElementById('q');
      const results = document.getElementById('results');

      // Small sample suggestions/quick results (local only)
      const sample = [
        {title: 'Smile Search — About', desc:'Halaman demo untuk Smile Search.'},
        {title: 'How to make a smiley', desc:'Tips membuat logo tersenyum di SVG.'},
        {title: 'Black & White design', desc: 'Inspirasi desain monokrom untuk UI.'}
      ];

      function renderSamples(){
        results.innerHTML = '';
        for(const s of sample){
          const div = document.createElement('div');
          div.className='card';
          div.innerHTML = `<div class="title">${escapeHtml(s.title)}</div><div class="desc">${escapeHtml(s.desc)}</div>`;
          results.appendChild(div);
        }
      }

      function escapeHtml(text){
        return text.replace(/[&<>"]+/g, function(match){
          return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'})[match];
        });
      }

      // Focus shortcut: '/'
      window.addEventListener('keydown', e => {
        if(e.key === '/'){
          if(document.activeElement !== input){
            e.preventDefault(); input.focus(); input.select();
          }
        }
      });

      // On load, show samples
      renderSamples();

      form.addEventListener('submit', e => {
        e.preventDefault();
        const q = (input.value || '').trim();
        if(!q){
          // gentle shake animation for empty submit
          input.style.transition='transform .12s ease';
          input.style.transform='translateX(-6px)';
          setTimeout(()=>{input.style.transform='translateX(6px)';},120);
          setTimeout(()=>{input.style.transform='';},260);
          input.focus();
          return;
        }
        // Open Google search in new tab
        const url = 'https://www.google.com/search?q=' + encodeURIComponent(q);
        window.open(url, '_blank');
      });

      // Mobile: touch logo to focus input
      document.querySelector('.smile-svg').addEventListener('click', ()=> input.focus());

    })();
  </script></body>
</html>
